# Cluster Infrastructure
kind_cluster_name        = "research-cluster"
kind_cluster_node_image  = "kindest/node:v1.35.0"
kind_cluster_config_path = "~/.kube/config"
worker_node_count        = 2
control_plane_node_count = 1  # Use 3 for HA (high availability)

# Kubernetes API and Feature Gates
enable_feature_gates  = false # Set to true to apply the feature_gates map configuration below
enable_runtime_config = false # Set to true to apply the runtime_config map configuration below

runtime_config = {
  "scheduling.k8s.io/v1alpha1" = "true"
}

feature_gates = {
  "GenericWorkload"       = true
  "GangScheduling"        = true
  "OpportunisticBatching" = true
}

# Network / Ingress
enable_ingress_lb = false